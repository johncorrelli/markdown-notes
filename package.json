{
  "name": "johncorrelli-markdown-notes",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "prettier": "prettier --write 'src/**/*.{ts,tsx}'",
    "stylelint": "stylelint 'src/**/*.scss' --fix"
  },
  "dependencies": {
    "classnames": "^2.5.1",
    "dropbox": "^10.66.0",
    "fuse.js": "^7.5.0",
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.12.0",
    "keycode-js": "^3.1.0",
    "localforage": "^1.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/hast": "^3.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "postcss-scss": "^4.0.9",
    "prettier": "^3.10.1",
    "sass": "^1.108.2",
    "stylelint": "^18.0.0",
    "stylelint-order": "^8.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
